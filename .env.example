# === Pipedrive ===
PIPEDRIVE_API_TOKEN=

# === Supabase ===
# Era opcional enquanto a automação era só disparo a partir dos campos do card
# (decisão de 07/08/2026: rodar sem banco, o card como único registro).
# Deixou de ser com o formulário (18/08/2026): é onde o proposal_spec grava o
# que foi preenchido. Sem estas vars o formulário salva em lugar nenhum.
# Rodar as migrations de supabase/migrations/ na ordem.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Google (Docs API + Drive API) — service account ===
# Base64 do JSON da service account. A conta precisa de acesso de Editor na
# pasta "Modelo Propostas" do Drive.
GOOGLE_PROPOSAL_SA_KEY_BASE64=
# Opcional — pasta do Drive onde as cópias geradas ficam.
PROPOSAL_OUTPUT_FOLDER_ID=

# === Proposta Automatizada — piloto ===
# Liga a automação (default false — nada roda sem isso).
PROPOSAL_AUTOMATION_ENABLED=false
# Enquanto true (default), só PROPOSAL_TEST_DEAL_ID dispara a geração.
# PROPOSAL_TEST_ONLY=false
# ID do card de teste no pipe "5. Vendas".
PROPOSAL_TEST_DEAL_ID=
# Token pra chamar POST /api/proposal/generate/:dealId manualmente (opcional
# em dev, recomendado em prod). Gerar com: openssl rand -base64 32
PROPOSAL_ADMIN_TOKEN=
# Secret do webhook. Sem ele a URL é pública — qualquer um que a descubra
# dispara geração em qualquer deal. Depois de preencher aqui, edite a inscrição
# no Pipedrive acrescentando ?secret=<valor> no fim da subscription_url.
# Gerar com: openssl rand -hex 16
PROPOSAL_WEBHOOK_SECRET=

PORT=3838

# === Formulário de proposta (18/08/2026) ===
# Liga a criação da atividade "Gerar proposta pelo formulário" para o DONO do
# negócio quando o card entra em "Envio de proposta". Separado de
# PROPOSAL_AUTOMATION_ENABLED de propósito: a atividade só cria tarefa interna,
# não manda nada pro cliente, então pode ser ligada muito antes da geração.
PROPOSAL_ACTIVITY_ENABLED=false

# ID do cliente OAuth (Google Cloud → Credenciais → Aplicativo da Web). Só o
# ID, não o secret — o front manda o ID token e o back verifica. Sem esta var
# o formulário responde 503: falha fechada, não liberado.
GOOGLE_OAUTH_CLIENT_ID=

# Domínio Workspace aceito no login. Default branddi.com.
# PROPOSAL_FORM_DOMAIN=branddi.com

# Base da URL que vai no link da atividade. Default é a produção da Vercel;
# em dev, http://localhost:3838
# PROPOSAL_FORM_BASE_URL=
